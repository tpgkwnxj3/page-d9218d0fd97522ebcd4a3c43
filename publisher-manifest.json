lex;gap:16px;flex-wrap:wrap;justify-content:space-between}\nfooter strong{color:#fff;letter-spacing:.2em;font-size:13px}\n</style><main>\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-top\">\n        <div class=\"brandmark\">筋斗云<span>订阅说明页</span></div>\n        <div class=\"stamp\">条款与额度以本页正文为准</div>\n      </div>\n\n      <nav class=\"anchors\" aria-label=\"页内导航\">\n        <a href=\"#usage\">怎么用</a>\n        <a href=\"#plans\">三档套餐</a>\n        <a href=\"#devices\">设备与客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n\n      <div class=\"hero-grid\">\n        <div>\n          <h1>筋斗云：把<em>流量、设备、线路</em>讲清，再让你决定。</h1>\n          <p class=\"hero-lead\">\n            这是一份订阅说明，不是广告。三档套餐、每档的月度额度、可同时在线设备数、\n            年付价格，全部写在同一页里。<strong>先看数字，再挑档位。</strong>\n          </p>\n          <div class=\"hero-notes\">\n            <div>套餐分基础版、旗舰版、团队版，价格从 ¥15/月 起。</div>\n            <div>年付价单独列出，不打包折扣话术。</div>\n            <div>每档写清流量上限与设备数量，不做模糊表述。</div>\n          </div>\n        </div>\n\n        <aside class=\"panel\" aria-label=\"套餐速览\">\n          <h2>速览</h2>\n          <dl>\n            <div class=\"row\"><dt>月付起价</dt><dd>¥15 / 月</dd></div>\n            <div class=\"row\"><dt>年付起价</dt><dd>¥150 / 年</dd></div>\n            <div class=\"row\"><dt>档位数量</dt><dd>3 档</dd></div>\n            <div class=\"row\"><dt>最高月流量</dt><dd>1000GB</dd></div>\n            <div class=\"row\"><dt>最多同时在线</dt><dd>20 台</dd></div>\n          </dl>\n          <p class=\"foot\">价格为页面标注值；具体可用节点与线路以实际开通页面说明为准。</p>\n        </aside>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"usage\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"kicker\">使用说明</div>\n        <h2>三步走完：选档、装客户端、核对额度</h2>\n        <p>把流程压到最短。每一步都写明你会看到什么，不写“轻松搞定”这种空话。</p>\n      </div>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"n\">STEP 01</div>\n          <h3>先核对自身用量</h3>\n          <p>看三件事：一个人用还是多人共用、主要在几台设备上、每月大致消耗多少流量。</p>\n          <ul>\n            <li>1–3 台设备，选基础版。</li>\n            <li>3–5 台设备且需要更多流量，选旗舰版。</li>\n            <li>多人共用或需要统一管理，选团队版。</li>\n          </ul>\n        </article>\n        <article class=\"step\">\n          <div class=\"n\">STEP 02</div>\n          <h3>下载客户端并登录</h3>\n          <p>客户端下载入口以开通后页面提供的说明为准。本页不提供下载直链，避免版本错配。</p>\n          <ul>\n            <li>确认系统版本与客户端版本匹配。</li>\n            <li>登录后先看剩余流量与设备占用。</li>\n            <li>遇到登录问题，先回到开通页面核对账号。</li>\n          </ul>\n        </article>\n        <article class=\"step\">\n          <div class=\"n\">STEP 03</div>\n          <h3>按档位核对权益</h3>\n          <p>开通后逐条比对：月流量、同时在线设备数、可用线路范围，三项都要对得上。</p>\n          <ul>\n            <li>额度按自然月统计，具体口径以开通页说明为准。</li>\n            <li>设备数按同时在线计算，超出会被限制登录。</li>\n            <li>需要调整档位时，先看清变更生效时间。</li>\n          </ul>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"kicker\">套餐</div>\n        <h2>三档阶梯：从一台设备到二十台设备</h2>\n        <p>按档位递增排列。每档的流量、设备数与年付价写在一起，不做隐藏条款。</p>\n      </div>\n\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-name\">基础版</div>\n            <div class=\"plan-tier\">Tier 1 · 个人起步</div>\n            <div class=\"plan-price\">¥15<small> / 月</small></div>\n            <div class=\"plan-year\">按年付仅需 ¥150 / 年</div>\n          </div>\n          <div class=\"plan-right\">\n            <ul>\n              <li>每月 100GB 流量</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>基础流媒体解锁</li>\n              <li>普通线路节点池</li>\n            </ul>\n          </div>\n        </article>\n\n        <article class=\"plan featured\">\n          <div class=\"badge-feature\">多数人选择</div>\n          <div>\n            <div class=\"plan-name\">旗舰版</div>\n            <div class=\"plan-tier\">Tier 2 · 进阶</div>\n            <div class=\"plan-price\">¥35<small> / 月</small></div>\n            <div class=\"plan-year\">按年付仅需 ¥350 / 年</div>\n          </div>\n          <div class=\"plan-right\">\n            <ul>\n              <li>每月 300GB 流量</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-name\">团队版</div>\n            <div class=\"plan-tier\">Tier 3 · 多人共用</div>\n            <div class=\"plan-price\">¥85<small> / 月</small></div>\n            <div class=\"plan-year\">按年付仅需 ¥850 / 年</div>\n          </div>\n          <div class=\"plan-right\">\n            <ul>\n              <li>每月 1000GB 流量</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n            <p class=\"plan-note\">团队版涉及路由定制，开通前需要与客户经理确认具体配置，实际部署内容以双方确认为准。</p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"devices\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"kicker\">设备与客户端</div>\n        <h2>先看你手上有什么设备，再决定要不要升档</h2>\n        <p>下面按设备类别说明适用注意点。本页不放下载地址，入口以开通后页面为准。</p>\n      </div>\n      <div class=\"devices\">\n        <article class=\"device\">\n          <h3>桌面电脑</h3>\n          <p>Windows 与 macOS 是最常见的使用场景。适合长时间连接与多窗口并行，占用一台设备名额。</p>\n          <div class=\"meta\">占 1 台设备</div>\n        </article>\n        <article class=\"device\">\n          <h3>手机</h3>\n          <p>iOS 与 Android 均可使用。出门在外时按需开启，不必全天占用设备名额。</p>\n          <div class=\"meta\">占 1 台设备</div>\n        </article>\n        <article class=\"device\">\n          <h3>平板</h3>\n          <p>适合看视频与阅读。若与手机同账号分流使用，需要预留两台设备名额。</p>\n          <div class=\"meta\">占 1 台设备</div>\n        </article>\n        <article class=\"device\">\n          <h3>路由器</h3>\n          <p>家庭共用时通常挂在路由器上。配置方式因机型差异较大，建议先确认型号再操作。</p>\n          <div class=\"meta\">占 1 台设备</div>\n        </article>\n      </div>\n      <p class=\"plain-note\">\n        设备数量的统计口径是“同时在线”。退出登录后名额会被释放，但释放时间可能略有延迟；\n        如果你刚好卡在临界值，先退出不用的设备，再登录新设备。\n      </p>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"kicker\">常见问题</div>\n        <h2>按主题分组：套餐、额度、设备、变更</h2>\n        <p>问题按类别拆开，方便直接定位。答案只写本页能确认的内容。</p>\n      </div>\n\n      <div class=\"faq-groups\">\n        <div class=\"faq-group\">\n          <h3>套餐与价格</h3>\n          <div class=\"qa\">\n            <h4>三档套餐的月付价分别是多少？</h4>\n            <p>基础版 ¥15/月，旗舰版 ¥35/月，团队版 ¥85/月。年付价分别为 ¥150/年、¥350/年、¥850/年。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>年付和月付差在哪？</h4>\n            <p>差别体现在计费周期与总价上，套餐内的流量与设备数量不因付费周期而改变。年付按整年一次结清。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>旗舰版为什么被标成“多数人选择”？</h4>\n            <p>这是本页的推荐标记，用于提示档位之间的位置关系，不代表统计结论或用户评价。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>流量与额度</h3>\n          <div class=\"qa\">\n            <h4>每档每月给多少流量？</h4>\n            <p>基础版 100GB，旗舰版 300GB，团队版 1000GB，均按月计算。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>流量用完了会怎样？</h4>\n            <p>本页不承诺超额后的具体处理方式。请在开通前于开通页面确认超额规则，再决定是否升档。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>额度什么时候重置？</h4>\n            <p>按自然月统计的具体起止时间以开通页面说明为准，本页不做额外承诺。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>设备与客户端</h3>\n          <div class=\"qa\">\n            <h4>能同时登录几台设备？</h4>\n            <p>基础版 3 台，旗舰版 5 台，团队版 20 台，均指同时在线数量。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>客户端从哪里获取？</h4>\n            <p>本页不提供下载直链。请以开通后页面给出的客户端说明与入口为准，避免拿到不匹配的版本。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>路由器算一台设备吗？</h4>\n            <p>是。挂在路由器上使用同样占用一个同时在线名额，家庭共用时要把这点算进去。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>变更与支持</h3>\n          <div class=\"qa\">\n            <h4>可以中途换档吗？</h4>\n            <p>换档涉及生效时间与费用差额，规则以开通页面或客户经理说明为准，本页不给出统一口径。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>工单支持有什么差别？</h4>\n            <p>旗舰版列出 7x24 优先工单支持，团队版列出专属客户经理服务。基础版未列出优先支持项。</p>\n          </div>\n          <div class=\"qa\">\n            <h4>企业定制路由怎么谈？</h4>\n            <p>团队版包含定制路由配置，具体内容需要与专属客户经理逐项确认后再实施。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band\">\n    <div class=\"wrap\">\n      <div>\n        <div class=\"tag\">下一步</div>\n        <h2>先量自己的用量，再点开对应档位。</h2>\n        <p>本页只负责把数字讲清楚：价格、流量、设备数、年付价。其余判断留给你。</p>\n      </div>\n      <div class=\"anchors\">\n        <a href=\"#plans\">回到套餐</a>\n        <a href=\"#faq\">再看问题</a>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <strong>筋斗云</strong>\n    <span>订阅说明页 · 价格与额度以本页正文为准</span>\n  </div>\n</footer>",
